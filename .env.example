SECRET_KEY=your_secret_key

# Set to True for development, False for production
# WARNING: Don't use DEBUG=True in production
DEBUG=False

# Allowed hosts for the application. Use a comma to separate multiple hosts
# Example: ALLOWED_HOSTS=localhost,
ALLOWED_HOSTS=localhost,

# CSRF (Cross-Site Request Forgery) trusted origins
# This is a security feature to prevent CSRF attacks
# Note: Make sure to include the protocol (http:// or https://)
# Example: CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=https://localhost:8000